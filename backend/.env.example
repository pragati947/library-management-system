# Database Configuration
# Change 'your_mysql_password' to your actual MySQL root password.
# Example: mysql+pymysql://root:password123@localhost:3306/library_db
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/library_db

# Fallback mode: If MySQL is not reachable or credentials fail, automatically use SQLite
FALLBACK_TO_SQLITE=True
SQLITE_URL=sqlite:///./library.db

# JWT & Authentication Secret
SECRET_KEY=supersecretjwtkey_for_intelligent_library_management_system_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Library Business Configuration
DEFAULT_DAILY_FINE_RATE=5.00
DEFAULT_BORROW_DAYS=14

